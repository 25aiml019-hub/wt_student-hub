# StudentHub Environment Configuration Template
# Copy this file to .env and adjust the values for your local development environment.

# Application Settings
APP_NAME="StudentHub"
APP_ENV="development"
APP_DEBUG=true
APP_URL="http://localhost:8000"

# Database Configuration (MySQL / XAMPP)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="studenthub"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=false

# Upload Settings
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES="jpg,jpeg,png,gif,webp"
