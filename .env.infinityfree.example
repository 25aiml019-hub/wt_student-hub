# StudentHub — InfinityFree Production Environment Configuration Template
# Rename this file to .env on your InfinityFree server (in the same directory as index.php)
# Obtain these values from your InfinityFree Client Area and Control Panel (cPanel)

APP_NAME="StudentHub"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://your-subdomain.infinityfreeapp.com"

# -----------------------------------------------------------------------------
# InfinityFree MySQL Database Configuration
# Find these in InfinityFree Control Panel -> MySQL Databases
# -----------------------------------------------------------------------------
# NOTE: InfinityFree MySQL host is NEVER 'localhost'!
# It looks like: sql123.infinityfree.com or sql234.epizy.com
DB_HOST="sqlXXX.infinityfree.com"
DB_PORT=3306
DB_NAME="epiz_XXXXXXXX_studenthub"
DB_USER="epiz_XXXXXXXX"
DB_PASS="YOUR_INFINITYFREE_ACCOUNT_PASSWORD"
DB_CHARSET="utf8mb4"

# -----------------------------------------------------------------------------
# Session Security Configuration
# -----------------------------------------------------------------------------
SESSION_LIFETIME=3600
# Set to true once your free SSL certificate is active on InfinityFree
SESSION_SECURE=true

# -----------------------------------------------------------------------------
# File Upload Settings (InfinityFree supports up to 10MB; app limit is 5MB)
# -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES="jpg,jpeg,png,webp,pdf"
