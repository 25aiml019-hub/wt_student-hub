# Prevent execution of any scripts in the uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|exe|sh|py)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable directory indexing and execution of CGI
Options -Indexes -ExecCGI

# Force downloaded files not to be interpreted as scripts
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .exe
