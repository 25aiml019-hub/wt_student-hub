# StudentHub Production Environment Configuration Template
# Set these variables in your hosting provider's environment settings or production .env

APP_NAME="StudentHub"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://your-domain.com"

# Production Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="production_db_name"
DB_USER="production_db_user"
DB_PASS="production_db_password"
DB_CHARSET="utf8mb4"

# Secure Production Session Settings
SESSION_LIFETIME=3600
SESSION_SECURE=true

# Upload Restrictions
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES="jpg,jpeg,png,webp,pdf"
